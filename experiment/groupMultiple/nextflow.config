params {
    minSizeGB = 0.8
    maxSizeGB = 1.0
    numberOfTasks = 100
}

process {
    
    container = 'fabianlehmann/test1:fio'

    withName: 'writeLargeFile' {
        cpus = 10
        memory = '10240.MB'
    }
    withName: 'revertFile' {
        cpus = 10
        memory = '10240.MB'
    }
    withName: 'combineFilesA' {
        cpus = 10
        memory = '20240.MB'
    }
    withName: 'combineFilesB' {
        cpus = 10
        memory = '20240.MB'
    }
    
}
